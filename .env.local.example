# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Le Rameau"

# Cron sécurisé (token secret pour protéger /api/cron/check-expirations)
# Doit correspondre à la valeur configurée dans Vercel Cron → Authorization header
CRON_SECRET=your-long-random-secret-here
